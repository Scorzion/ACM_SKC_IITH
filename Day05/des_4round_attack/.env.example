# Shared secret key for the oracle (same for all students).
# Must be exactly 14 hexadecimal characters = 56-bit DES key.
ORACLE_KEY=3A5B7C9D2E4F6A

# Optional: per-IP query budget. Default is 1000/day if unset.
# Raise this if many students share one campus NAT/VPN IP, e.g. 4000/day.
# RATE_LIMIT=1000/day

# Optional: host port nginx listens on (used by docker-compose). Default 80.
# LISTEN_PORT=80
